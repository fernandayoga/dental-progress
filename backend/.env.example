# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
# If left empty or connection fails in development, automatic in-memory MongoDB will be used.
MONGO_URI=mongodb://localhost:27017/dental_progress

# JWT Authentication
JWT_SECRET=super_secure_dental_progress_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
# Set these with your Cloudinary credentials.
# If not configured, photos will safely be stored in local disk /uploads directory for testing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dental_progress
